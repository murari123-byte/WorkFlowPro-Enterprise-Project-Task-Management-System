# WorkFlowPro environment variables
# 1. Copy this file:            cp .env.example .env
# 2. Replace every change-me value with your own password (e.g. `openssl rand -hex 16`)
# 3. NEVER commit .env - it is git-ignored.
#
# Docker Compose reads .env automatically.
# Spring Boot does NOT - load it into your shell before starting a service:
#   set -a; source .env; set +a

# ---- Service ports (8080-8084 are avoided on purpose) ----
GATEWAY_PORT=9080
AUTH_SERVICE_PORT=9081
PROJECT_SERVICE_PORT=9082
TASK_SERVICE_PORT=9083
NOTIFICATION_SERVICE_PORT=9084

# ---- API Gateway: where each service runs ----
# Change these when services run on other hosts (e.g. in Docker: http://auth-service:9081)
AUTH_SERVICE_URL=http://localhost:9081
PROJECT_SERVICE_URL=http://localhost:9082
TASK_SERVICE_URL=http://localhost:9083
NOTIFICATION_SERVICE_URL=http://localhost:9084
# Browser origins allowed to call the gateway (comma-separated). 5173 = React dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- PostgreSQL server (Docker container "workflowpro-postgres") ----
DB_HOST=localhost
DB_PORT=5440
# Superuser, used only by the container init script and for troubleshooting
POSTGRES_ADMIN_USER=workflowpro_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# ---- One database + one account per service ----
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth

PROJECT_DB_NAME=project_db
PROJECT_DB_USER=project_user
PROJECT_DB_PASSWORD=change-me-project

TASK_DB_NAME=task_db
TASK_DB_USER=task_user
TASK_DB_PASSWORD=change-me-task

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me-notification

# ---- JWT (auth-service) ----
# Secret used to sign access tokens (HS256). At least 32 characters. Generate: openssl rand -base64 48
# Every service that validates tokens must use the SAME value.
JWT_SECRET=change-me-jwt-secret
JWT_ISSUER=workflowpro-auth
# Durations: 15m = 15 minutes, 7d = 7 days
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ---- API docs ----
# Swagger UI + /v3/api-docs. Set to false in production.
SWAGGER_ENABLED=true
