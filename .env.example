# WorkFlowPro environment variables
# Copy this file to .env and change values as needed:  cp .env.example .env
# NEVER commit .env - it is git-ignored.
#
# Spring Boot does not read .env by itself. Load it into your shell first:
#   set -a; source .env; set +a

# ---- Service ports (defaults shown; 8080-8084 are avoided on purpose) ----
GATEWAY_PORT=9080
AUTH_SERVICE_PORT=9081
PROJECT_SERVICE_PORT=9082
TASK_SERVICE_PORT=9083
NOTIFICATION_SERVICE_PORT=9084

# ---- Added in later steps ----
# Step 2: PostgreSQL connection settings (host, port, per-service DB names, credentials)
# Step 6+: JWT secret
