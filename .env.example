# WorkFlowPro environment variables
# 1. Copy this file:            cp .env.example .env
# 2. Replace every change-me value with your own password (e.g. `openssl rand -hex 16`)
# 3. NEVER commit .env - it is git-ignored.
#
# Docker Compose reads .env automatically.
# Spring Boot does NOT - load it into your shell before starting a service:
#   set -a; source .env; set +a

# ---- Service ports (8080-8084 are avoided on purpose) ----
GATEWAY_PORT=9080
AUTH_SERVICE_PORT=9081
PROJECT_SERVICE_PORT=9082
TASK_SERVICE_PORT=9083
NOTIFICATION_SERVICE_PORT=9084

# ---- PostgreSQL server (Docker container "workflowpro-postgres") ----
DB_HOST=localhost
DB_PORT=5440
# Superuser, used only by the container init script and for troubleshooting
POSTGRES_ADMIN_USER=workflowpro_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# ---- One database + one account per service ----
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth

PROJECT_DB_NAME=project_db
PROJECT_DB_USER=project_user
PROJECT_DB_PASSWORD=change-me-project

TASK_DB_NAME=task_db
TASK_DB_USER=task_user
TASK_DB_PASSWORD=change-me-task

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me-notification

# ---- Added in later steps ----
# JWT secret (auth phase)
